{# ---------------------------------------------------------------------------
   Shared http-context state: maps, rate-limit zones, header-routing tables.
   Rendered by gateway/services.py. Loaded before upstreams and servers because
   conf.d/*.conf is included in filename order.
   --------------------------------------------------------------------------- #}

# ---------------------------------------------------------------------------
# Cache status, surfaced to clients as X-Cache-Status.
#
# $upstream_cache_status is empty on routes that do not cache at all, which
# would emit a blank header and leave you unsure whether caching was off or
# the header was missing. "-" says "this route does not cache" out loud.
# ---------------------------------------------------------------------------
map $upstream_cache_status $cache_status_display {
    default  $upstream_cache_status;
    ""       "-";
}

# ---------------------------------------------------------------------------
# Is this response a static asset?
#
# Decided on the response's own content type rather than the request's file
# extension, because the extension is a guess about what the backend will send
# and the content type is what it actually sent. A route serving /assets/x.js
# through a framework that answers with an error page is the case that makes
# the difference.
#
# This can only ever govern *storing* a response -- see the note in
# 20-servers.conf about why it must never reach proxy_cache_bypass.
# ---------------------------------------------------------------------------
map $upstream_http_content_type $response_is_static {
    default                            0;
    ~*^image/                          1;
    ~*^font/                           1;
    ~*^audio/                          1;
    ~*^video/                          1;
    ~*^text/css                        1;
    ~*^text/javascript                 1;
    ~*^application/javascript          1;
    ~*^application/x-javascript        1;
    ~*^application/wasm                1;
    ~*^application/vnd\.ms-fontobject  1;
    ~*^application/x-font              1;
    ~*^application/font-woff           1;
}

# proxy_no_cache stores the response when every parameter is empty or "0", and
# refuses when any is anything else. So "static" has to map to the empty
# string: it is the value that means "no objection to caching this".
map $response_is_static $deny_dynamic_cache {
    1        "";
    default  "1";
}

# ---------------------------------------------------------------------------
# Is this a signed-in request?
#
# Decided by the session cookie the frameworks behind this gateway actually
# set. Matching only cookies literally called "session" or "sessionid" missed
# nearly all of them: Laravel names its cookie <app>_session, PHP PHPSESSID,
# Java JSESSIONID, Express connect.sid, ASP.NET ASP.NET_SessionId, Drupal
# SESS<hash>, Rails _<app>_session, WordPress wordpress_logged_in_<hash>. A
# signed-in page missed by that test could be stored and served to the next
# visitor -- the one failure a cache must never have.
#
# CSRF cookies are deliberately absent: Laravel's XSRF-TOKEN is set for
# anonymous visitors too, and says nothing about who is signed in.
# ---------------------------------------------------------------------------
map $http_cookie $request_has_session {
    default  "";
    "~*(^|;\s*)(PHPSESSID|JSESSIONID|ASP\.NET_SessionId|ASPSESSIONID[A-Z]+|\.AspNetCore\.(Session|Cookies)|connect\.sid|sessionid|session|sid|_session_id|[A-Za-z0-9_.-]*[_-]session|S?SESS[0-9a-f]+|wordpress_logged_in_[A-Za-z0-9]+|wp-postpass_[A-Za-z0-9]+|remember_[A-Za-z0-9_]+)="  1;
}

# A static file by its address, for the one decision made before a response
# exists: whether to look in the cache at all.
map $uri $uri_is_static {
    default  0;
    "~*\.(css|js|mjs|map|png|jpe?g|gif|webp|avif|svg|ico|bmp|woff2?|ttf|otf|eot|mp3|mp4|webm|ogg|wasm)$"  1;
}

# Browsers send the session cookie with every request, stylesheets and
# scripts included. Skipping the cache for all of them would send every
# signed-in visitor's asset requests to the backend -- correct, and slow for
# no reason, since a stylesheet is the same for everyone. So a signed-in
# request skips the cache only for what is not a static file:
#
#   reading  decided on the address, the only thing known beforehand;
#   storing  decided on what the backend actually sent.
map "$request_has_session:$uri_is_static" $session_cache_bypass {
    default  "";
    "1:0"    1;
}

map "$request_has_session:$response_is_static" $session_no_store {
    default  "";
    "1:0"    1;
}

# ---------------------------------------------------------------------------
# Long-lived browser caching, for routes that opt in.
#
# Only for static responses, and only when the backend said nothing about
# caching itself: a backend that sets its own Cache-Control knows better
# than the gateway does. An empty value makes add_header send nothing.
# ---------------------------------------------------------------------------
map "$response_is_static:$upstream_http_cache_control" $browser_cache_static {
    default  "";
    "1:"     "public, max-age=31536000, immutable";
}

# ---------------------------------------------------------------------------
# Misses the cache was never allowed to turn into hits.
#
# The traffic module reports MISS for two different things: a response that
# was not cached *yet*, and one that will never be cached because the backend
# forbade it -- a page with a session cookie, or marked private or no-cache.
# The first is the cache doing its job; the second is the backend doing its
# job. Counted together, a Laravel or Django app whose pages are per-user
# reads as a cache that hardly works, when every response it could have kept
# it did.
#
# These maps name the second kind, so the hit ratio can leave it out of its
# denominator. Each is "refused" only on a MISS, and empty otherwise -- and the
# traffic module skips a filter whose key is empty, so only refusals are
# counted. Which map a route uses depends on what it honours: a route told to
# ignore the backend's Cache-Control does cache a no-cache page, so for it
# that header refuses nothing.
#
# The conditions are Nginx's own: it will not store a response carrying
# Set-Cookie, Vary: *, or Cache-Control no-store, no-cache, private or a zero
# max-age.
# ---------------------------------------------------------------------------
map $upstream_http_cache_control $backend_cc_forbids {
    default                                                        "";
    "~*(no-store|no-cache|private|(^|[ ,])(s-)?max-?age=0+([ ,]|$))"  "c";
}

map $upstream_http_set_cookie $backend_sets_cookie {
    default  "s";
    ""       "";
}

map $upstream_http_vary $backend_varies_on_everything {
    default  "";
    "~^\s*\*\s*$"  "v";
}

map "$upstream_cache_status:$backend_cc_forbids$backend_sets_cookie$backend_varies_on_everything" $cache_refused {
    default  "";
    "~^MISS:.+"  refused;
}

map "$upstream_cache_status:$backend_sets_cookie$backend_varies_on_everything" $cache_refused_cc_ignored {
    default  "";
    "~^MISS:.+"  refused;
}

# Static-only routes also refuse anything that is not a static asset; that is
# proxy_no_cache doing it, through $deny_dynamic_cache above.
map "$upstream_cache_status:$backend_cc_forbids$backend_sets_cookie$backend_varies_on_everything$deny_dynamic_cache" $cache_refused_static {
    default  "";
    "~^MISS:.+"  refused;
}

map "$upstream_cache_status:$backend_sets_cookie$backend_varies_on_everything$deny_dynamic_cache" $cache_refused_static_cc_ignored {
    default  "";
    "~^MISS:.+"  refused;
}

# ---------------------------------------------------------------------------
# Accept-Encoding, normalised for use in cache keys.
#
# Clients send dozens of spellings of the same three encodings. Keying on the
# raw header shatters one cached object into one entry per client string; this
# collapses it back to three.
# ---------------------------------------------------------------------------
map $http_accept_encoding $encoding_key {
    default   "";
    "~*zstd"  "zstd";
    "~*br"    "br";
    "~*gzip"  "gzip";
}

# ---------------------------------------------------------------------------
# Connection header for upgrade-capable routes (WebSocket, SSE).
# ---------------------------------------------------------------------------
map $http_upgrade $connection_upgrade {
    default  upgrade;
    ""       "";
}

{% if protection.enabled %}
# ---------------------------------------------------------------------------
# Per-address limits, applied to every public domain.
#
# These bound what one address can consume. They stop a single host, a scraper
# or a small botnet from exhausting workers or backends, and they cost one hash
# lookup per request.
#
# They do nothing about a volumetric flood. By the time enough packets arrive to
# saturate the uplink, none of them have reached Nginx and no setting in this
# file is involved. That problem is answered upstream, by a provider who can
# absorb it.
# ---------------------------------------------------------------------------
limit_conn_zone $binary_remote_addr zone=per_ip_conn:16m;
limit_req_zone  $binary_remote_addr zone=per_ip_req:16m rate={{ protection.per_ip_requests_per_second }}r/s;

# 429 rather than 503: it says "you, slow down" instead of "this service is
# broken", which is both true and less useful to someone probing for capacity.
limit_conn_status 429;
limit_req_status  429;
{% endif %}

{% if blocked_addresses %}
# ---------------------------------------------------------------------------
# Refused addresses.
#
# Answered with 444, which closes the connection without sending a response.
# The client learns nothing, and the gateway spends almost nothing.
# ---------------------------------------------------------------------------
geo $blocked_client {
    default 0;
{% for entry in blocked_addresses %}
    {{ entry.cidr }} 1;{% if entry.note %}  # {{ entry.note|nginx_comment }}{% endif %}

{% endfor %}
}
{% endif %}

{% if rate_limited_rules %}
# ---------------------------------------------------------------------------
# Per-route rate limiting, keyed on client address.
# ---------------------------------------------------------------------------
{% for rule in rate_limited_rules %}
limit_req_zone $binary_remote_addr zone=rl_{{ rule.slug }}:10m rate={{ rule.rate_limit_rps }}r/s;
{% endfor %}
{% endif %}

{% if header_routed_rules %}
# ---------------------------------------------------------------------------
# Header-based backend selection.
#
# Each map resolves to an upstream block name. Nginx matches a variable
# proxy_pass against declared upstreams before it considers DNS, so these keep
# the upstream keepalive pool; the cost is one hash lookup per request.
# ---------------------------------------------------------------------------
{% for rule in header_routed_rules %}
# {{ rule.domain_name|nginx_comment }}{{ rule.match_value|nginx_comment }} — switches on {{ rule.header_name|nginx_comment }}
map {{ rule.header_variable }} $target_{{ rule.slug }} {
    default  {{ rule.default_upstream }};
{% for route in rule.header_routes %}
    {{ route.header_value|nginx_quoted }}  {{ route.upstream_name }};{% if route.description %}  # {{ route.description|nginx_comment }}{% endif %}

{% endfor %}
}

{% endfor %}
{% endif %}
