# Generated Nginx configuration. The database is the source of truth; these
# files are rendered from it on every deploy.
#
# Ignore the whole directory and re-admit the one hand-written file, rather
# than listing the generated ones. A managed file added later is then covered
# automatically -- and a generated file that reached the repository would be
# written over the server's own copy by the deploy checkout.
gateway/nginx/conf.d/*
!gateway/nginx/conf.d/default.conf

# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.sqlite3
staticfiles/

# Node
node_modules/
frontend/dist/
.vite/

# Benchmarks
benchmarks/results/*
!benchmarks/results/.gitkeep

# Editors and OS
.DS_Store
.idea/
.vscode/
tsconfig.tsbuildinfo
