{# ---------------------------------------------------------------------------
   One server block per active domain, plus a TLS block where a certificate
   exists.

   Every domain gets a port-80 listener serving the ACME challenge path from
   the moment it is created, whether or not it has a certificate yet. That is
   what removes the usual bootstrap problem: by the time anyone asks for a
   certificate, the challenge is already answerable.
   --------------------------------------------------------------------------- #}
{% macro proxy_headers(rule) %}
        proxy_http_version 1.1;
{% if rule.proxy_buffering %}
        proxy_set_header Connection        "";
{% else %}
        # Upgrade-capable route: Connection carries the upgrade token instead
        # of being cleared. Set once -- nginx adds every proxy_set_header in a
        # context rather than replacing, so a second one would send the header
        # twice and the handshake would fail.
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
{% endif %}
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Request-ID      $request_id;
{% if rule.proxy_buffering %}
        proxy_read_timeout {{ rule.proxy_read_timeout }}s;
{% else %}
        # On an upgraded connection these bound idle time, not response time.
        # Both directions are needed: a socket that is quiet inbound but not
        # outbound would still be closed by the one that was left short.
        proxy_read_timeout {{ rule.proxy_read_timeout }}s;
        proxy_send_timeout {{ rule.proxy_read_timeout }}s;
{% endif %}
{% for header_name, header_value in rule.custom_headers.items() %}
        proxy_set_header {{ header_name }} {{ header_value|nginx_quoted }};
{% endfor %}
{%- endmacro %}
{% macro routes(domain) %}
{% if blocked_addresses %}
    # Checked before anything else runs. `if` is discouraged in Nginx, but
    # `if` with a bare `return` is one of the two uses documented as safe.
    if ($blocked_client) {
        return 444;
    }
{% endif %}
{% if protection.enabled %}
    # The floor beneath any per-route limit. A domain with no rate-limited
    # route is still bounded.
    limit_conn per_ip_conn {{ protection.per_ip_connections }};
    limit_req  zone=per_ip_req burst={{ protection.per_ip_burst }} nodelay;
{% endif %}

    access_log /var/log/nginx/{{ domain.name }}.access.log main buffer=64k flush=5s;
    error_log  /var/log/nginx/{{ domain.name }}.error.log warn;

    # Per-vhost counters for the traffic-status module.
    vhost_traffic_status_filter_by_set_key $server_name host::$server_name;

{% for rule in domain.rules %}
    # {{ rule.match_value|nginx_comment }} -> {{ rule.backend_name|nginx_comment }} (priority {{ rule.priority }}{% if rule.cache_enabled %}, cached {{ rule.cache_ttl }}s{% endif %}{% if rule.header_routes %}, {{ rule.header_routes|length }} header override{{ '' if rule.header_routes|length == 1 else 's' }}{% endif %})
    location {{ rule.nginx_location }} {
{% if rule.rate_limit_enabled %}
        limit_req        zone=rl_{{ rule.slug }} burst={{ rule.rate_limit_burst }} nodelay;
        limit_req_status 429;
{% endif %}
{% if rule.strip_prefix %}
        rewrite ^{{ rule.match_value }}/?(.*)$ /$1 break;
{% endif %}
{% if rule.header_routes %}
        proxy_pass {{ rule.scheme }}://$target_{{ rule.slug }};
{% else %}
        proxy_pass {{ rule.scheme }}://{{ rule.upstream_name }};
{% endif %}
{% if rule.scheme == "https" %}

        # The backend speaks TLS. SNI carries the hostname the client asked
        # for, not the upstream's address, because a router on the other end
        # matches on that name -- without it every request looks like a
        # request for an IP and matches nothing.
        proxy_ssl_server_name on;
        proxy_ssl_name        {{ rule.tls_server_name }};

        # Reusing the session is what keeps a TLS hop affordable: the
        # handshake happens once per connection, and the connection is held
        # open by the upstream keepalive pool.
        proxy_ssl_session_reuse on;
        proxy_ssl_protocols     TLSv1.2 TLSv1.3;
{% if rule.tls_verify %}
        proxy_ssl_verify       on;
        proxy_ssl_verify_depth 2;
{% if rule.tls_trusted_ca_path %}
        proxy_ssl_trusted_certificate {{ rule.tls_trusted_ca_path }};
{% endif %}
{% else %}
        # Not verified. An internal backend usually presents a self-signed or
        # private-CA certificate, and failing closed on that takes the route
        # down rather than making it safer. Turn verification on, with a CA
        # bundle, where the network between here and the backend is not yours.
        proxy_ssl_verify off;
{% endif %}
{% endif %}

{{ proxy_headers(rule) }}
{% if not rule.proxy_buffering %}
        # Streaming route. Responses pass straight through; nothing that
        # arrives in pieces over a held connection can be cached anyway.
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
{% elif rule.cache_enabled %}
        # Caching: {{ "static assets only" if rule.cache_mode == "static" else "every cacheable response" }}.
        proxy_cache         gateway_cache;
{% if rule.cache_ignore_query_string %}
        # Keyed on the path alone. A flood carrying random query parameters
        # would otherwise miss on every request and hand the whole load to the
        # backend, turning the cache from a shield into a liability.
        proxy_cache_key     "$scheme$host$request_method$uri{{ rule.cache_key_suffix }}";
{% else %}
        proxy_cache_key     "$scheme$host$request_method$request_uri{{ rule.cache_key_suffix }}";
{% endif %}
        proxy_cache_methods GET HEAD;

        # A fallback for responses carrying no caching headers of their own.
        # Anything the backend does say -- Cache-Control, Expires, ETag --
        # still takes precedence over these values.
        proxy_cache_valid   200 302 {{ rule.cache_ttl }}s;

        # Deliberately no `proxy_cache_valid 404`. Negative caching turns a
        # transient backend or routing fault into one that outlives its own
        # cause: the 404 keeps being served after the fix, and -- through
        # proxy_cache_use_stale below -- for considerably longer than its TTL.
        # A backend that genuinely wants its 404s cached can still say so with
        # Cache-Control, which is honoured.
        proxy_cache_min_uses {{ rule.cache_min_uses }};

        # Revalidate with If-None-Match / If-Modified-Since on expiry, so an
        # unchanged object costs a 304 rather than a fresh transfer.
        proxy_cache_revalidate on;

        # stale-while-revalidate: serve the stale copy immediately, refresh in
        # the background, and let exactly one request through to the backend.
        proxy_cache_use_stale         updating error timeout http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_lock              on;
        proxy_cache_lock_age          5s;
        proxy_cache_lock_timeout      5s;
{% if rule.cache_ignore_upstream_control %}

        # Overriding the backend's own caching headers, by explicit request.
        proxy_ignore_headers Cache-Control Expires;
{% endif %}
{% if rule.cache_bypass_auth %}

        # Authenticated requests reach the backend and are never stored.
        # proxy_cache_bypass on its own would still write the response into the
        # cache for the next anonymous caller, so proxy_no_cache below carries
        # these same variables.
        proxy_cache_bypass $http_authorization $cookie_sessionid $cookie_session;
{% endif %}
{% if rule.cache_mode == "static" %}

        # Static assets only. $deny_dynamic_cache is non-empty for any response
        # that is not an image, font, stylesheet, script, or media file, which
        # keeps HTML and API responses out of the cache without anyone having to
        # describe them in advance.
        #
        # It appears here and nowhere else. proxy_cache_bypass is evaluated
        # before the request is sent, when $upstream_http_content_type is still
        # empty -- the map would read that as "not static", bypass every lookup,
        # and the cache would never be read from at all. Storing is a decision
        # that can be made from the response; reading is not.
{% endif %}
{% set no_cache = [] %}
{% if rule.cache_mode == "static" %}{% set _ = no_cache.append("$deny_dynamic_cache") %}{% endif %}
{% if rule.cache_bypass_auth %}{% set _ = no_cache.extend(["$http_authorization", "$cookie_sessionid", "$cookie_session"]) %}{% endif %}
{% if no_cache %}
        # One directive, not several: nginx keeps only the last proxy_no_cache
        # in a context, so a second would silently discard the first.
        proxy_no_cache {{ no_cache|join(" ") }};
{% endif %}
{% endif %}

        add_header X-Cache-Status $cache_status_display always;
        add_header X-Request-ID   $request_id always;
    }

{% endfor %}
{% if not domain.has_root_rule %}
    location / {
        default_type application/json;
        return 404 '{"error":"No route is configured for this path on {{ domain.name }}."}';
    }
{% endif %}
{% endmacro %}
{% for domain in domains %}
# ===========================================================================
# {{ domain.name|nginx_comment }}{% if domain.ssl_enabled %} -- TLS, {{ domain.cert_issuer_label|nginx_comment }}{% else %} -- HTTP only{% endif %}

# ===========================================================================
server {
    listen 80;
    listen [::]:80;
    server_name {{ domain.name }};

    # Answered over plain HTTP forever: renewals happen while the site is
    # already on HTTPS, and the CA always validates on port 80.
    location ^~ /.well-known/acme-challenge/ {
        root {{ acme_webroot }};
        default_type "text/plain";
        access_log off;
{% if domain.acme_challenge_passthrough %}
        # Our own token wins when there is one; anything else goes to the
        # backend. Both this gateway and a backend managing its own
        # certificates can then complete a challenge, because neither takes
        # the path away from the other.
        try_files $uri @acme_backend;
{% else %}
        try_files $uri =404;
{% endif %}
    }
{% if domain.acme_challenge_passthrough %}

    location @acme_backend {
        proxy_pass {{ domain.acme_scheme }}://{{ domain.acme_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host            $host;
        proxy_set_header X-Real-IP       $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # The authority reached us over plain HTTP on port 80, whatever
        # scheme we then use to reach the backend.
        proxy_set_header X-Forwarded-Proto http;
{% if domain.acme_scheme == "https" %}
        proxy_ssl_server_name on;
        proxy_ssl_name        $host;
        proxy_ssl_verify      off;
{% endif %}
        access_log off;
    }
{% endif %}

{% if domain.ssl_enabled and domain.force_ssl_redirect %}
    location / {
        return 301 https://$host$request_uri;
    }
{% else %}
{{ routes(domain) }}
{% endif %}
}

{% if domain.ssl_enabled %}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ domain.name }};

    ssl_certificate     {{ domain.ssl_cert_path }};
    ssl_certificate_key {{ domain.ssl_key_path }};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache   shared:TLS{{ domain.slug }}:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
{% if domain.ocsp_chain_path %}
    # Emitted only when the leaf certificate names an OCSP responder. Let's
    # Encrypt removed that URL in 2025, and Nginx warns on every single reload
    # about an ssl_stapling directive it is then going to ignore.
    ssl_stapling            on;
    ssl_stapling_verify     on;
    ssl_trusted_certificate {{ domain.ocsp_chain_path }};
{% endif %}

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

{{ routes(domain) }}
}
{% endif %}

{% endfor %}
{% if not domains %}
# No active domains have routes yet. Add one in the control panel.
{% endif %}
