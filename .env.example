# =============================================================================
# CloudBalancer
#
# Copy to .env and change everything marked CHANGE ME before this is reachable
# from anywhere but your own machine.
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_DB=cloudbalancer
POSTGRES_USER=cloudbalancer
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Django ----
# CHANGE ME: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.base

# Only needed while the panel's dev server runs on its own port. In production
# Nginx serves the panel and the API from one origin and neither applies.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8081,http://localhost:5173

# ---- First run ----
# `make init` creates this account, then leaves these unused.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# ---- Gateway ----
NGINX_VERSION=1.30.6
# Shared with the Nginx container. The panel writes a request here and a
# watcher in that container runs nginx -t or nginx -s reload. This is why
# the management container no longer needs the Docker socket.
NGINX_CONTROL_DIR=/var/run/cloudbalancer
NGINX_CONTROL_TIMEOUT=30
NGINX_CONF_DIR=/etc/nginx/conf.d
NGINX_SSL_DIR=/etc/nginx/ssl
NGINX_CACHE_DIR=/var/cache/nginx

# Seconds to gather changes before deploying. Editing several rules should cost
# one reload, not one each: every reload starts workers with empty connection
# pools to the backends.
GATEWAY_DEPLOY_DEBOUNCE=3

# Seconds between health probes.
HEALTH_CHECK_INTERVAL=15

# ---- Certificates ----
# Set these and `make init` registers the account for you.
ACME_EMAIL=
ACME_AGREE_TOS=false
# Start with staging: certificates browsers will not trust, but far looser
# limits while you confirm that issuance works. Production allows 5 failed
# attempts per hostname per hour.
ACME_STAGING=true
ACME_KEY_TYPE=ecdsa
LETSENCRYPT_DIR=/etc/letsencrypt
ACME_WEBROOT_DIR=/var/www/acme
CERTBOT_TIMEOUT=180

# ---- Control panel security ----
# The name shown in operators' authenticator apps.
TOTP_ISSUER=CloudBalancer

# ---- DNS-01 and wildcard certificates ----
# Encrypts DNS provider credentials in the database. They are in every
# nightly backup, so this is what keeps a dump copied elsewhere from being a
# working Cloudflare token. Its own key, not SECRET_KEY, which gets rotated
# for unrelated reasons -- a rotation that silently broke every provider
# would surface at the next renewal, weeks later.
#   openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=
# Where a provider's credentials file is written for the length of one
# certbot run. Inside the container only, mode 0600, removed afterwards.
DNS_CREDENTIALS_DIR=/var/lib/letsencrypt/dns-credentials

# ---- Backups ----
# Where archives land on the host. A named Docker volume by default, which
# protects against mistakes but not against the disk dying with the database
# on it. Point this at another filesystem, and copy it off the host.
# BACKUP_HOST_DIR=/srv/backups/cloudbalancer
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=12
# How old the newest *verified* backup may be before the panel complains.
BACKUP_STALE_HOURS=36
# Encryption at rest. 64 hex characters: openssl rand -hex 32
# An archive holds every TLS private key this gateway serves plus the whole
# audit trail, so set this before copying one anywhere. Store the key
# somewhere other than this host -- a key kept next to the thing it protects
# protects nothing, and losing it makes every archive unreadable.
# BACKUP_ENCRYPTION_KEY=

# ---- Alerts ----
# Shared secret Alertmanager presents when delivering to the control plane.
# Without it that endpoint accepts anything posted from inside the Compose
# network: openssl rand -hex 24
ALERTMANAGER_WEBHOOK_SECRET=
# Put in every notification so a message is one click from the page that
# explains it. e.g. https://cloudbalancer.example.org
ALERT_PANEL_URL=
ALERT_CHECK_INTERVAL=300
# How long before a still-firing alert is mentioned again. Acknowledging one
# stops this for that alert.
ALERT_REPEAT_MINUTES=60
ALERT_RETENTION_DAYS=90
ALERT_CERT_WARNING_DAYS=14
ALERT_CERT_CRITICAL_DAYS=3
ALERT_DISK_WARNING_PERCENT=15
ALERT_DISK_CRITICAL_PERCENT=5

# ---- Email ----
# Only used for alert channels of kind "email". Left empty, such a channel
# refuses to send rather than discarding messages to a console nobody reads.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=cloudbalancer@example.org

# ---- Traffic analytics ----
# Built from Nginx's access logs, which are the only place a client address,
# a path or a country exists -- the traffic-status module aggregates per
# vhost and knows none of it.
ANALYTICS_INGEST_INTERVAL=300
ANALYTICS_MAX_LINES_PER_RUN=200000
# Complete IP addresses are personal data. Long enough to investigate abuse,
# short enough not to be a standing record of who visited what. The country
# and network aggregates they feed are kept far longer and carry no address.
ANALYTICS_CLIENT_RETENTION_DAYS=30
ANALYTICS_PATH_RETENTION_DAYS=90
ANALYTICS_AGGREGATE_RETENTION_DAYS=400

# ---- Access log rotation ----
# Done by the gateway container, which owns the files -- the control plane
# mounts them read-only, and log growth must not depend on it being up.
# Size-triggered, because a log is a problem when it is large rather than
# when it is old. The ingester follows a file across the rename, so nothing
# is lost and nothing is counted twice.
NGINX_LOG_ROTATE_BYTES=67108864
NGINX_LOG_KEEP=14
# Seconds between size checks. 0 disables rotation entirely.
NGINX_LOG_CHECK_SECONDS=60
# The shortest gap between two rotations of the same file. Only the newest
# rotation stays readable, so this has to comfortably exceed
# ANALYTICS_INGEST_INTERVAL above -- otherwise a very busy domain can have a
# file compressed before the ingester has read it, and those requests are on
# disk but missing from the counts.
NGINX_LOG_MIN_INTERVAL_SECONDS=900
# Rotate everything once a day as well, whatever its size, so that a file is
# a day of traffic and zgrep by date is useful. 0 leaves only the size
# trigger, and a quiet domain then gets one file covering months.
NGINX_LOG_MAX_AGE_MINUTES=1440

# ---- Geolocation ----
# dbip needs no account and is CC-BY, so the attribution must stay visible.
# maxmind is more accurate and needs a free account plus a licence key.
GEOIP_PROVIDER=dbip
# MAXMIND_LICENSE_KEY=
# Fetch with: docker compose exec django python manage.py geoip_update
# Refreshed automatically on the 4th of each month.

# ---- Observability ----
NGINX_VTS_URL=http://nginx:8080/status/format/json
PROMETHEUS_URL=http://prometheus:9090
# How long traffic history is kept, and the disk ceiling that overrides it.
# The panel's longest chart range is a year, so anything under 365d means the
# oldest end of that chart is empty. Budget roughly 5-6 MB per series per year
# at the current scrape intervals; this gateway's own metrics are a few hundred
# series, and each domain adds about seventeen more.
PROMETHEUS_RETENTION=400d
PROMETHEUS_MAX_DISK=24GB
GRAFANA_URL=http://localhost:3000
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# ---- Reaching the panel on a port ----
# By default the panel is published only on loopback and reached through an
# SSH tunnel. To open it on a network address instead, set all three:
#
#   PANEL_BIND=10.0.0.5                        the interface to publish on
#   DJANGO_ALLOWED_HOSTS=10.0.0.5,localhost    or Django answers 400
#   CSRF_TRUSTED_ORIGINS=http://10.0.0.5:8081  or every write is rejected
#
# And, if that address is served over plain HTTP rather than HTTPS:
#
#   PANEL_COOKIE_SECURE=false
#
# Browsers discard a Secure cookie that arrives over http://<an-ip>, so
# without this the sign-in succeeds and then bounces straight back to the
# form. localhost is exempt, which is why a tunnel does not need it.
#
# Leaving it false means credentials and the session cookie cross the network
# in clear text. Fine on a private LAN or a VPN. Not on a public address --
# there, give the panel a hostname and a certificate instead, under
# Security -> Publish the panel.
#PANEL_COOKIE_SECURE=false

# ---- Exposure ----
# The control panel and the observability tools are admin surfaces. They bind
# to loopback by default; set these to 0.0.0.0 only behind a VPN or a firewall.
PANEL_BIND=127.0.0.1
OBSERVABILITY_BIND=127.0.0.1
