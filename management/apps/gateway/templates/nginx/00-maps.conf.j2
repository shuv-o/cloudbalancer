{# ---------------------------------------------------------------------------
   Shared http-context state: maps, rate-limit zones, header-routing tables.
   Rendered by gateway/services.py. Loaded before upstreams and servers because
   conf.d/*.conf is included in filename order.
   --------------------------------------------------------------------------- #}

# ---------------------------------------------------------------------------
# Cache status, surfaced to clients as X-Cache-Status.
#
# $upstream_cache_status is empty on routes that do not cache at all, which
# would emit a blank header and leave you unsure whether caching was off or
# the header was missing. "-" says "this route does not cache" out loud.
# ---------------------------------------------------------------------------
map $upstream_cache_status $cache_status_display {
    default  $upstream_cache_status;
    ""       "-";
}

# ---------------------------------------------------------------------------
# Is this response a static asset?
#
# Decided on the response's own content type rather than the request's file
# extension, because the extension is a guess about what the backend will send
# and the content type is what it actually sent. A route serving /assets/x.js
# through a framework that answers with an error page is the case that makes
# the difference.
#
# This can only ever govern *storing* a response -- see the note in
# 20-servers.conf about why it must never reach proxy_cache_bypass.
# ---------------------------------------------------------------------------
map $upstream_http_content_type $response_is_static {
    default                            0;
    ~*^image/                          1;
    ~*^font/                           1;
    ~*^audio/                          1;
    ~*^video/                          1;
    ~*^text/css                        1;
    ~*^text/javascript                 1;
    ~*^application/javascript          1;
    ~*^application/x-javascript        1;
    ~*^application/wasm                1;
    ~*^application/vnd\.ms-fontobject  1;
    ~*^application/x-font              1;
    ~*^application/font-woff           1;
}

# proxy_no_cache stores the response when every parameter is empty or "0", and
# refuses when any is anything else. So "static" has to map to the empty
# string: it is the value that means "no objection to caching this".
map $response_is_static $deny_dynamic_cache {
    1        "";
    default  "1";
}

# ---------------------------------------------------------------------------
# Accept-Encoding, normalised for use in cache keys.
#
# Clients send dozens of spellings of the same three encodings. Keying on the
# raw header shatters one cached object into one entry per client string; this
# collapses it back to three.
# ---------------------------------------------------------------------------
map $http_accept_encoding $encoding_key {
    default   "";
    "~*zstd"  "zstd";
    "~*br"    "br";
    "~*gzip"  "gzip";
}

# ---------------------------------------------------------------------------
# Connection header for upgrade-capable routes (WebSocket, SSE).
# ---------------------------------------------------------------------------
map $http_upgrade $connection_upgrade {
    default  upgrade;
    ""       "";
}

{% if protection.enabled %}
# ---------------------------------------------------------------------------
# Per-address limits, applied to every public domain.
#
# These bound what one address can consume. They stop a single host, a scraper
# or a small botnet from exhausting workers or backends, and they cost one hash
# lookup per request.
#
# They do nothing about a volumetric flood. By the time enough packets arrive to
# saturate the uplink, none of them have reached Nginx and no setting in this
# file is involved. That problem is answered upstream, by a provider who can
# absorb it.
# ---------------------------------------------------------------------------
limit_conn_zone $binary_remote_addr zone=per_ip_conn:16m;
limit_req_zone  $binary_remote_addr zone=per_ip_req:16m rate={{ protection.per_ip_requests_per_second }}r/s;

# 429 rather than 503: it says "you, slow down" instead of "this service is
# broken", which is both true and less useful to someone probing for capacity.
limit_conn_status 429;
limit_req_status  429;
{% endif %}

{% if blocked_addresses %}
# ---------------------------------------------------------------------------
# Refused addresses.
#
# Answered with 444, which closes the connection without sending a response.
# The client learns nothing, and the gateway spends almost nothing.
# ---------------------------------------------------------------------------
geo $blocked_client {
    default 0;
{% for entry in blocked_addresses %}
    {{ entry.cidr }} 1;{% if entry.note %}  # {{ entry.note|nginx_comment }}{% endif %}

{% endfor %}
}
{% endif %}

{% if rate_limited_rules %}
# ---------------------------------------------------------------------------
# Per-route rate limiting, keyed on client address.
# ---------------------------------------------------------------------------
{% for rule in rate_limited_rules %}
limit_req_zone $binary_remote_addr zone=rl_{{ rule.slug }}:10m rate={{ rule.rate_limit_rps }}r/s;
{% endfor %}
{% endif %}

{% if header_routed_rules %}
# ---------------------------------------------------------------------------
# Header-based backend selection.
#
# Each map resolves to an upstream block name. Nginx matches a variable
# proxy_pass against declared upstreams before it considers DNS, so these keep
# the upstream keepalive pool; the cost is one hash lookup per request.
# ---------------------------------------------------------------------------
{% for rule in header_routed_rules %}
# {{ rule.domain_name|nginx_comment }}{{ rule.match_value|nginx_comment }} — switches on {{ rule.header_name|nginx_comment }}
map {{ rule.header_variable }} $target_{{ rule.slug }} {
    default  {{ rule.default_upstream }};
{% for route in rule.header_routes %}
    {{ route.header_value|nginx_quoted }}  {{ route.upstream_name }};{% if route.description %}  # {{ route.description|nginx_comment }}{% endif %}

{% endfor %}
}

{% endfor %}
{% endif %}
