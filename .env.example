# =============================================================================
# CloudBalancer
#
# Copy to .env and change everything marked CHANGE ME before this is reachable
# from anywhere but your own machine.
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_DB=cloudbalancer
POSTGRES_USER=cloudbalancer
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Django ----
# CHANGE ME: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.base

# Only needed while the panel's dev server runs on its own port. In production
# Nginx serves the panel and the API from one origin and neither applies.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8081,http://localhost:5173

# ---- First run ----
# `make init` creates this account, then leaves these unused.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# ---- Gateway ----
NGINX_VERSION=1.27.4
NGINX_CONTAINER_NAME=cloudbalancer-nginx
NGINX_CONF_DIR=/etc/nginx/conf.d
NGINX_SSL_DIR=/etc/nginx/ssl
NGINX_CACHE_DIR=/var/cache/nginx

# Seconds to gather changes before deploying. Editing several rules should cost
# one reload, not one each: every reload starts workers with empty connection
# pools to the backends.
GATEWAY_DEPLOY_DEBOUNCE=3

# Seconds between health probes.
HEALTH_CHECK_INTERVAL=15

# ---- Certificates ----
# Set these and `make init` registers the account for you.
ACME_EMAIL=
ACME_AGREE_TOS=false
# Start with staging: certificates browsers will not trust, but far looser
# limits while you confirm that issuance works. Production allows 5 failed
# attempts per hostname per hour.
ACME_STAGING=true
ACME_KEY_TYPE=ecdsa
LETSENCRYPT_DIR=/etc/letsencrypt
ACME_WEBROOT_DIR=/var/www/acme
CERTBOT_TIMEOUT=180

# ---- Control panel security ----
# The name shown in operators' authenticator apps.
TOTP_ISSUER=CloudBalancer

# ---- Observability ----
NGINX_VTS_URL=http://nginx:8080/status/format/json
PROMETHEUS_URL=http://prometheus:9090
# How long traffic history is kept, and the disk ceiling that overrides it.
# The panel's longest chart range is a year, so anything under 365d means the
# oldest end of that chart is empty. Budget roughly 5-6 MB per series per year
# at the current scrape intervals; this gateway's own metrics are a few hundred
# series, and each domain adds about seventeen more.
PROMETHEUS_RETENTION=400d
PROMETHEUS_MAX_DISK=24GB
GRAFANA_URL=http://localhost:3000
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# ---- Reaching the panel on a port ----
# By default the panel is published only on loopback and reached through an
# SSH tunnel. To open it on a network address instead, set all three:
#
#   PANEL_BIND=10.0.0.5                        the interface to publish on
#   DJANGO_ALLOWED_HOSTS=10.0.0.5,localhost    or Django answers 400
#   CSRF_TRUSTED_ORIGINS=http://10.0.0.5:8081  or every write is rejected
#
# And, if that address is served over plain HTTP rather than HTTPS:
#
#   PANEL_COOKIE_SECURE=false
#
# Browsers discard a Secure cookie that arrives over http://<an-ip>, so
# without this the sign-in succeeds and then bounces straight back to the
# form. localhost is exempt, which is why a tunnel does not need it.
#
# Leaving it false means credentials and the session cookie cross the network
# in clear text. Fine on a private LAN or a VPN. Not on a public address --
# there, give the panel a hostname and a certificate instead, under
# Security -> Publish the panel.
#PANEL_COOKIE_SECURE=false

# ---- Exposure ----
# The control panel and the observability tools are admin surfaces. They bind
# to loopback by default; set these to 0.0.0.0 only behind a VPN or a firewall.
PANEL_BIND=127.0.0.1
OBSERVABILITY_BIND=127.0.0.1
